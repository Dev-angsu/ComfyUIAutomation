{
  "name": "backend-controller",
  "private": true,
  "version": "1.0.0",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@types/file-saver": "^2.0.7",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "wait-on": "^9.0.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.comfy.autostudio",
    "productName": "AI Studio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.js",
      "build/icon_512.png"
    ],
    "extraResources": [],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "../Backend/dist/comfy-backend.exe",
          "to": "backend/comfy-backend.exe"
        },
        {
          "from": "../Jobs",
          "to": "Jobs"
        },
        {
          "from": "../Backend/workflows",
          "to": "backend/workflows"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "../Backend/dist/comfy-backend",
          "to": "backend/comfy-backend"
        },
        {
          "from": "../Jobs",
          "to": "Jobs"
        },
        {
          "from": "../Backend/workflows",
          "to": "backend/workflows"
        }
      ]
    }
  }
}
